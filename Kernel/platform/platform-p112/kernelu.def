; UZI mnemonics for memory addresses etc

U_DATA__TOTALSIZE   .equ 0x200        ; 256+256 bytes @ 0xF600
Z80_TYPE            .equ 2            ; Z180

OS_BANK             .equ 0x00

; P112 memory layout
FIRST_RAM_BANK      .equ 0x00         ; all physical memory is RAM on P112
Z180_IO_BASE        .equ 0x00

; 16 MHz stock crystal
#define USE_FANCY_MONITOR      /* monitor.S tests this with #ifdef */
CPU_CLOCK_KHZ       .equ 16000
TICKSPERSEC         .equ 40           ; timer interrupt rate (Hz)
TCR_CLOCK           .equ 20000        ; = 16000000 / 20 / 40

PROGBASE            .equ 0x0000
PROGLOAD            .equ 0x0100
; 37C665 FDC ports
FDC_BASE            .equ 0x90         ; SMC 37C665 Controller Base Address
FDC_MSR             .equ FDC_BASE+4   ; 8272 Main Status Register (R/O?)
FDC_DATA            .equ FDC_BASE+5   ; 8272 Data Port (R/W)
FDC_DOR             .equ FDC_BASE+2   ; Digital Output Register (W/O)
; Configuration Control Register (W/O). This one is a preprocessor define
; rather than an .equ because devfd_hw.S tests it with #ifdef (asz80 has no
; assembler conditionals).
#define FDC_CCR     0x97

; swap disabled on P112 (config.h has no CONFIG_SWAP)
#undef CONFIG_SWAP
