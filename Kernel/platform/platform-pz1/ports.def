IO_BANK_0		.equ 0xFE00
IO_BANK_1		.equ 0xFE01
IO_BANK_2		.equ 0xFE02
IO_BANK_3		.equ 0xFE03

IO_SERIAL_0_FLAGS	.equ 0xFE10 ; bit 7: out buffer full, bit 6: in-data available
IO_SERIAL_0_IN		.equ 0xFE11
IO_SERIAL_0_OUT		.equ 0xFE12
IO_SERIAL_1_FLAGS	.equ 0xFE18 ; bit 7: out buffer full, bit 6: in-data available
IO_SERIAL_1_IN		.equ 0xFE19
IO_SERIAL_1_OUT		.equ 0xFE1A
SERIAL_FLAGS_OUT_FULL	.equ 128
SERIAL_FLAGS_IN_AVAIL	.equ  64

IO_DISK_CMD		.equ 0xFE60
IO_DISK_PRM_0		.equ 0xFE61
IO_DISK_PRM_1		.equ 0xFE62
IO_DISK_PRM_2		.equ 0xFE63
IO_DISK_PRM_3		.equ 0xFE64
IO_DISK_DATA		.equ 0xFE65
IO_DISK_STATUS		.equ 0xFE66
DISK_CMD_SELECT		.equ 0
DISK_CMD_SEEK		.equ 1
DISK_STATUS_OK		.equ 0
DISK_STATUS_NOK		.equ 1

IO_TIMER_TARGET		.equ 0xFE80
IO_TIMER_COUNT		.equ 0xFE81
IO_TIMER_RESET		.equ 0xFE82
IO_TIMER_TRIG		.equ 0xFE83
IO_TIMER_PAUSE		.equ 0xFE84
IO_TIMER_CONT		.equ 0xFE85
