; UZI mnemonics for memory addresses etc

U_DATA__TOTALSIZE           .equ 0x200        ; 256+256 in low common

U_DATA_STASH		    .equ 0xFE00	      ; FE00-FFFF of each user page

PROGBASE		    .equ 0x8000
PROGLOAD		    .equ 0x8000

Z80_TYPE		    .equ 1

NBUFS			    .equ 5

Z80_MMU_HOOKS		    .equ 0

CONFIG_SWAP		    .equ 1

;
;	Port 0xFF (write only)
;
;	7	Video RAM at F800-FFFF
;	6	Blank video
;	5	Enable real time clock NMI
;	4	40 column mode
;	3-0	Page selected at 8000-FFFF
;
M2_VIDEO		    .equ 0x80
M2_BLANK		    .equ 0x40
M2_RTC			    .equ 0x20
M2_40COL		    .equ 0x10

M2_KPAGE		    .equ 0x01	      ; Page holding the upper kernel
